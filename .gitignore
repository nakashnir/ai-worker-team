# Secrets and env
.env
.env.*

# Backups and noise
*.bak.*
RUNBOOK.md.bak*
docker-compose.yml.bak.*

# Python caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Temporary upload/cache artifacts
tmp_upload/
*.tmp
*.swp

# Runtime outputs
shared/runs/*
shared/reports/*
shared/docs/*
artifacts/nightly/*

# Keep runtime directories
!shared/runs/.gitkeep
!shared/reports/.gitkeep
!shared/docs/.gitkeep
